{$SITE_ADDRESS} {
    encode zstd gzip

    @api path /api /api/*
    handle @api {
        reverse_proxy backend:8080
    }

    handle /assets/* {
        root * /srv
        file_server
    }

    handle {
        root * /srv
        try_files {path} /index.html
        header Cache-Control "no-cache"
        file_server
    }
}
